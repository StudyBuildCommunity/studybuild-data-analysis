            <column-instance column="[DriverAgeGroup]" derivation="Attribute" name="[attribute:DriverAgeGroup:nk]" pivot="key" type="nominal" />
            <column-instance column="[Claim Frequency]" derivation="None" name="[none:Claim Frequency:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Average Severity]" derivation="None" name="[none:Average Severity:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Exposure]" derivation="Sum" name="[sum:Exposure:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Arial" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Circle" />
            <encodings>
              <lod column="[federated.insurance_portfolio].[DriverAgeGroup]" />
              <color column="[federated.insurance_portfolio].[DriverAgeGroup]" />
              <size column="[federated.insurance_portfolio].[sum:Exposure:qk]" />
              <tooltip column="[federated.insurance_portfolio].[attribute:DriverAgeGroup:nk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run>Driver Age Group: &lt;[federated.insurance_portfolio].[attribute:DriverAgeGroup:nk]&gt;
</run>
                <run>Claim Frequency: &lt;[federated.insurance_portfolio].[Claim Frequency]&gt;
</run>
                <run>Average Severity: &lt;[federated.insurance_portfolio].[Average Severity]&gt;
</run>
                <run>Exposure: &lt;[federated.insurance_portfolio].[sum:Exposure:qk]&gt;
</run>
                <run>Marker area represents Exposure; select a mark to highlight its matrix row.
</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[federated.insurance_portfolio].[Average Severity]</rows>
        <cols>[federated.insurance_portfolio].[Claim Frequency]</cols>
      </table>
    </worksheet>
    <worksheet name="Vehicle Power Frequency">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#254C65" fontname="Arial" fontsize="11">Vehicle Power Claim Frequency</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Insurance Portfolio" name="federated.insurance_portfolio" />
          </datasources>
          <datasource-dependencies datasource="federated.insurance_portfolio">
            <column caption="Vehicle Power Group" datatype="string" name="[VehiclePowerGroup]" role="dimension" type="nominal" />
            <column caption="Claim Frequency" datatype="real" default-format="n0.0000" name="[Claim Frequency]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([ClaimNb]) / SUM([Exposure])" />
            </column>
            <column caption="Average Severity" datatype="real" default-format="c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)" name="[Average Severity]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF SUM([SeverityClaimCount]) = 0 THEN NULL ELSE SUM([TotalClaimAmount]) / SUM([SeverityClaimCount]) END" />
            </column>
            <column-instance column="[VehiclePowerGroup]" derivation="None" name="[none:VehiclePowerGroup:nk]" pivot="key" type="nominal" />
            <column-instance column="[Claim Frequency]" derivation="None" name="[none:Claim Frequency:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Average Severity]" derivation="None" name="[none:Average Severity:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Arial" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[federated.insurance_portfolio].[VehiclePowerGroup]" />
              <tooltip column="[federated.insurance_portfolio].[Average Severity]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run>Vehicle Power Group: &lt;[federated.insurance_portfolio].[VehiclePowerGroup]&gt;
</run>
                <run>Claim Frequency: &lt;[federated.insurance_portfolio].[Claim Frequency]&gt;
</run>
                <run>Average Severity: &lt;[federated.insurance_portfolio].[Average Severity]&gt;
</run>
                <run>Claim Frequency is reported claims per exposure year.
</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[federated.insurance_portfolio].[VehiclePowerGroup]</rows>
        <cols>[federated.insurance_portfolio].[Claim Frequency]</cols>
      </table>
    </worksheet>
    <worksheet name="Driver Vehicle Frequency Matrix">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#254C65" fontname="Arial" fontsize="11">Driver Age and Vehicle Power Frequency</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Insurance Portfolio" name="federated.insurance_portfolio" />
          </datasources>
          <datasource-dependencies datasource="federated.insurance_portfolio">
            <column caption="Driver Age Group" datatype="string" name="[DriverAgeGroup]" role="dimension" type="nominal" />
            <column caption="Vehicle Power Group" datatype="string" name="[VehiclePowerGroup]" role="dimension" type="nominal" />
            <column caption="Claim Frequency" datatype="real" default-format="n0.0000" name="[Claim Frequency]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([ClaimNb]) / SUM([Exposure])" />
            </column>
            <column caption="Exposure" datatype="real" name="[Exposure]" role="measure" type="quantitative" aggregation="Sum" default-format="n#,##0.0" />
            <column-instance column="[DriverAgeGroup]" derivation="None" name="[none:DriverAgeGroup:nk]" pivot="key" type="nominal" />
            <column-instance column="[VehiclePowerGroup]" derivation="None" name="[none:VehiclePowerGroup:nk]" pivot="key" type="nominal" />
            <column-instance column="[Claim Frequency]" derivation="None" name="[none:Claim Frequency:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Exposure]" derivation="Sum" name="[sum:Exposure:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Arial" />
          </style-rule>
          <style-rule element="mark">
            <format attr="mark-labels-show" value="true" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Square" />
            <encodings>
              <color column="[federated.insurance_portfolio].[Claim Frequency]" />
              <text column="[federated.insurance_portfolio].[Claim Frequency]" />
              <tooltip column="[federated.insurance_portfolio].[sum:Exposure:qk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run>Driver Age Group: &lt;[federated.insurance_portfolio].[DriverAgeGroup]&gt;
</run>
                <run>Vehicle Power Group: &lt;[federated.insurance_portfolio].[VehiclePowerGroup]&gt;
</run>
                <run>Claim Frequency: &lt;[federated.insurance_portfolio].[Claim Frequency]&gt;
</run>
                <run>Exposure: &lt;[federated.insurance_portfolio].[sum:Exposure:qk]&gt;
</run>
                <run>Use this matrix to compare claims per exposure year across paired segments.
</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[federated.insurance_portfolio].[DriverAgeGroup]</rows>
        <cols>[federated.insurance_portfolio].[VehiclePowerGroup]</cols>
      </table>
    </worksheet>
    <worksheet name="Pareto Curve">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#254C65" fontname="Arial" fontsize="11">Cumulative Claim Cost (Pareto)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Insurance Claims" name="federated.insurance_claims" />
          </datasources>
          <datasource-dependencies datasource="federated.insurance_claims">
            <column caption="Cumulative Claim Cost Share" datatype="real" name="[CumulativeClaimCostPct]" role="measure" type="quantitative" aggregation="Sum" default-format="p0.0%" />
            <column caption="Cumulative Claim Share" datatype="real" name="[CumulativeClaimPct]" role="measure" type="quantitative" aggregation="Sum" default-format="p0.0%" />
            <column caption="Claim Cost Rank" datatype="integer" name="[ClaimAmountRank]" role="dimension" type="ordinal" aggregation="Sum" />
            <column caption="Claim Amount" datatype="real" name="[ClaimAmount]" role="measure" type="quantitative" aggregation="Sum" default-format="c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)" />
            <column-instance column="[CumulativeClaimCostPct]" derivation="Avg" name="[avg:CumulativeClaimCostPct:qk]" pivot="key" type="quantitative" />
            <column-instance column="[CumulativeClaimPct]" derivation="Avg" name="[avg:CumulativeClaimPct:qk]" pivot="key" type="quantitative" />
            <column-instance column="[ClaimAmountRank]" derivation="None" name="[none:ClaimAmountRank:ok]" pivot="key" type="ordinal" />
            <column-instance column="[ClaimAmount]" derivation="Sum" name="[sum:ClaimAmount:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Arial" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <path column="[federated.insurance_claims].[none:ClaimAmountRank:ok]" />
              <tooltip column="[federated.insurance_claims].[sum:ClaimAmount:qk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run>Cumulative Claim Cost: &lt;[federated.insurance_claims].[avg:CumulativeClaimCostPct:qk]&gt;
</run>
                <run>Cumulative Claim Share: &lt;[federated.insurance_claims].[avg:CumulativeClaimPct:qk]&gt;
</run>
                <run>Claim Amount: &lt;[federated.insurance_claims].[sum:ClaimAmount:qk]&gt;
</run>
                <run>Use the curve to see how quickly high-cost claims accumulate the total cost.
</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[federated.insurance_claims].[avg:CumulativeClaimCostPct:qk]</rows>
        <cols>[federated.insurance_claims].[avg:CumulativeClaimPct:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="High Cost Claims">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#254C65" fontname="Arial" fontsize="11">Top 20 Claim Amounts</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Insurance Claims" name="federated.insurance_claims" />
          </datasources>
          <datasource-dependencies datasource="federated.insurance_claims">
            <column caption="Claim Cost Rank" datatype="integer" name="[ClaimAmountRank]" role="dimension" type="ordinal" aggregation="Sum" />
            <column caption="Claim Amount" datatype="real" name="[ClaimAmount]" role="measure" type="quantitative" aggregation="Sum" default-format="c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)" />
            <column caption="Extreme Claim Flag" datatype="boolean" name="[IsExtremeClaim]" role="dimension" type="nominal" />
            <column caption="Region" datatype="string" name="[Region]" role="dimension" type="nominal" />
            <column-instance column="[ClaimAmountRank]" derivation="None" name="[none:ClaimAmountRank:ok]" pivot="key" type="ordinal" />
            <column-instance column="[ClaimAmount]" derivation="Sum" name="[sum:ClaimAmount:qk]" pivot="key" type="quantitative" />
            <column-instance column="[IsExtremeClaim]" derivation="None" name="[none:IsExtremeClaim:nk]" pivot="key" type="nominal" />
            <column-instance column="[Region]" derivation="Attribute" name="[attribute:Region:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="quantitative" column="[federated.insurance_claims].[none:ClaimAmountRank:ok]" included-values="in-range">
            <min>1</min>
            <max>20</max>
          </filter>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Arial" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[federated.insurance_claims].[IsExtremeClaim]" />
              <tooltip column="[federated.insurance_claims].[attribute:Region:nk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run>Claim Cost Rank: &lt;[federated.insurance_claims].[none:ClaimAmountRank:ok]&gt;
</run>
                <run>Claim Amount: &lt;[federated.insurance_claims].[sum:ClaimAmount:qk]&gt;
</run>
                <run>Region: &lt;[federated.insurance_claims].[attribute:Region:nk]&gt;
</run>
                <run>These are the 20 largest observed claim amounts; retain valid high-cost claims in reporting.
</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[federated.insurance_claims].[none:ClaimAmountRank:ok]</rows>
        <cols>[federated.insurance_claims].[sum:ClaimAmount:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="High Cost Segments">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#254C65" fontname="Arial" fontsize="11">Total Claim Cost by Vehicle Power</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Insurance Portfolio" name="federated.insurance_portfolio" />
          </datasources>
          <datasource-dependencies datasource="federated.insurance_portfolio">
            <column caption="Vehicle Power Group" datatype="string" name="[VehiclePowerGroup]" role="dimension" type="nominal" />
            <column caption="Total Claim Cost" datatype="real" name="[TotalClaimAmount]" role="measure" type="quantitative" aggregation="Sum" default-format="c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)" />
            <column caption="Claim Frequency" datatype="real" default-format="n0.0000" name="[Claim Frequency]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([ClaimNb]) / SUM([Exposure])" />
            </column>
            <column-instance column="[VehiclePowerGroup]" derivation="None" name="[none:VehiclePowerGroup:nk]" pivot="key" type="nominal" />
            <column-instance column="[TotalClaimAmount]" derivation="Sum" name="[sum:TotalClaimAmount:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Claim Frequency]" derivation="None" name="[none:Claim Frequency:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Arial" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[federated.insurance_portfolio].[VehiclePowerGroup]" />
              <tooltip column="[federated.insurance_portfolio].[Claim Frequency]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run>Vehicle Power Group: &lt;[federated.insurance_portfolio].[VehiclePowerGroup]&gt;
</run>
                <run>Total Claim Cost: &lt;[federated.insurance_portfolio].[sum:TotalClaimAmount:qk]&gt;
</run>
                <run>Claim Frequency: &lt;[federated.insurance_portfolio].[Claim Frequency]&gt;
</run>
                <run>Compare Total Claim Cost with Claim Frequency rather than cost alone.
</run>
              </formatted-text>
            </customized-tooltip>
          </pane>
        </panes>
        <rows>[federated.insurance_portfolio].[VehiclePowerGroup]</rows>
        <cols>[federated.insurance_portfolio].[sum:TotalClaimAmount:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="Executive Portfolio Overview">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#1F4E79" fontname="Arial" fontsize="16">Executive Portfolio Overview</run>
          </formatted-text>
        </title>
      </layout-options>
      <size maxheight="900" maxwidth="1400" minheight="900" minwidth="1400" />
      <datasources>
        <datasource caption="Insurance Portfolio" name="federated.insurance_portfolio" />
      </datasources>
      <datasource-dependencies datasource="federated.insurance_portfolio">
        <column caption="IDpol" datatype="string" name="[IDpol]" role="dimension" type="nominal" />
        <column caption="VehPower" datatype="integer" name="[VehPower]" role="dimension" type="ordinal" aggregation="Sum" />
        <column caption="VehBrand" datatype="string" name="[VehBrand]" role="dimension" type="nominal" />
        <column caption="Fuel Type" datatype="string" name="[VehGas]" role="dimension" type="nominal" />
        <column caption="Area" datatype="string" name="[Area]" role="dimension" type="nominal" />
        <column caption="Region" datatype="string" name="[Region]" role="dimension" type="nominal" />
        <column caption="Driver Age Group" datatype="string" name="[DriverAgeGroup]" role="dimension" type="nominal" />
        <column caption="Vehicle Age Group" datatype="string" name="[VehicleAgeGroup]" role="dimension" type="nominal" />
        <column caption="Vehicle Power Group" datatype="string" name="[VehiclePowerGroup]" role="dimension" type="nominal" />
        <column caption="Bonus–Malus Group" datatype="string" name="[BonusMalusGroup]" role="dimension" type="nominal" />
        <column-instance column="[IDpol]" derivation="None" name="[none:IDpol:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehPower]" derivation="None" name="[none:VehPower:ok]" pivot="key" type="ordinal" />
        <column-instance column="[VehBrand]" derivation="None" name="[none:VehBrand:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehGas]" derivation="None" name="[none:VehGas:nk]" pivot="key" type="nominal" />
        <column-instance column="[Area]" derivation="None" name="[none:Area:nk]" pivot="key" type="nominal" />
        <column-instance column="[Region]" derivation="None" name="[none:Region:nk]" pivot="key" type="nominal" />
        <column-instance column="[DriverAgeGroup]" derivation="None" name="[none:DriverAgeGroup:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehicleAgeGroup]" derivation="None" name="[none:VehicleAgeGroup:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehiclePowerGroup]" derivation="None" name="[none:VehiclePowerGroup:nk]" pivot="key" type="nominal" />
        <column-instance column="[BonusMalusGroup]" derivation="None" name="[none:BonusMalusGroup:nk]" pivot="key" type="nominal" />
      </datasource-dependencies>
      <zones>
        <zone h="100000" id="1" type="layout-basic" w="100000" x="0" y="0">
          <zone h="5000" id="2" type="title" w="100000" x="0" y="0" />
          <zone fixed-size="3000" h="3000" id="3" is-fixed="true" type="text" w="100000" x="0" y="5000">
            <formatted-text>
              <run fontcolor="#404040" fontname="Arial" fontsize="10">Explore the selected portfolio with exposure-aware KPIs. Claim Frequency = Claim Count / Exposure (claims per exposure year); Total Claim Cost and Average Severity are shown in euros. Findings are descriptive associations, not causal conclusions.</run>
            </formatted-text>
          </zone>
          <zone h="3500" id="10" name="Regional Claim Frequency" param="[federated.insurance_portfolio].[Region]" show-null-ctrls="false" type="filter" values="relevant" w="20000" x="0" y="8000" />
          <zone h="3500" id="11" name="Regional Claim Frequency" param="[federated.insurance_portfolio].[VehGas]" show-null-ctrls="false" type="filter" values="relevant" w="20000" x="20000" y="8000" />
          <zone h="3500" id="12" name="Regional Claim Frequency" param="[federated.insurance_portfolio].[DriverAgeGroup]" show-null-ctrls="false" type="filter" values="relevant" w="20000" x="40000" y="8000" />
          <zone h="3500" id="13" name="Regional Claim Frequency" param="[federated.insurance_portfolio].[VehicleAgeGroup]" show-null-ctrls="false" type="filter" values="relevant" w="20000" x="60000" y="8000" />
          <zone h="3500" id="14" name="Regional Claim Frequency" param="[federated.insurance_portfolio].[BonusMalusGroup]" show-null-ctrls="false" type="filter" values="relevant" w="20000" x="80000" y="8000" />
          <zone h="14000" id="20" name="KPI Policy Count" show-title="true" w="16666" x="0" y="12000" />
          <zone h="14000" id="21" name="KPI Exposure" show-title="true" w="16666" x="16666" y="12000" />
          <zone h="14000" id="22" name="KPI Claim Count" show-title="true" w="16666" x="33332" y="12000" />
          <zone h="14000" id="23" name="KPI Claim Frequency" show-title="true" w="16666" x="49998" y="12000" />
          <zone h="14000" id="24" name="KPI Total Claim Cost" show-title="true" w="16666" x="66664" y="12000" />
          <zone h="14000" id="25" name="KPI Average Severity" show-title="true" w="16666" x="83330" y="12000" />
          <zone h="74000" id="30" name="Regional Claim Frequency" show-title="true" w="50000" x="0" y="26000" />
          <zone h="74000" id="31" name="Regional Claim Cost" show-title="true" w="50000" x="50000" y="26000" />
        </zone>
      </zones>
    </dashboard>
    <dashboard name="Claims &amp; Risk Segments">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#1F4E79" fontname="Arial" fontsize="16">Claims &amp; Risk Segments</run>
          </formatted-text>
        </title>
      </layout-options>
      <size maxheight="900" maxwidth="1400" minheight="900" minwidth="1400" />
      <datasources>
        <datasource caption="Insurance Portfolio" name="federated.insurance_portfolio" />
      </datasources>
      <datasource-dependencies datasource="federated.insurance_portfolio">
        <column caption="IDpol" datatype="string" name="[IDpol]" role="dimension" type="nominal" />
        <column caption="VehPower" datatype="integer" name="[VehPower]" role="dimension" type="ordinal" aggregation="Sum" />
        <column caption="VehBrand" datatype="string" name="[VehBrand]" role="dimension" type="nominal" />
        <column caption="Fuel Type" datatype="string" name="[VehGas]" role="dimension" type="nominal" />
        <column caption="Area" datatype="string" name="[Area]" role="dimension" type="nominal" />
        <column caption="Region" datatype="string" name="[Region]" role="dimension" type="nominal" />
        <column caption="Driver Age Group" datatype="string" name="[DriverAgeGroup]" role="dimension" type="nominal" />
        <column caption="Vehicle Age Group" datatype="string" name="[VehicleAgeGroup]" role="dimension" type="nominal" />
        <column caption="Vehicle Power Group" datatype="string" name="[VehiclePowerGroup]" role="dimension" type="nominal" />
        <column caption="Bonus–Malus Group" datatype="string" name="[BonusMalusGroup]" role="dimension" type="nominal" />
        <column-instance column="[IDpol]" derivation="None" name="[none:IDpol:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehPower]" derivation="None" name="[none:VehPower:ok]" pivot="key" type="ordinal" />
        <column-instance column="[VehBrand]" derivation="None" name="[none:VehBrand:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehGas]" derivation="None" name="[none:VehGas:nk]" pivot="key" type="nominal" />
        <column-instance column="[Area]" derivation="None" name="[none:Area:nk]" pivot="key" type="nominal" />
        <column-instance column="[Region]" derivation="None" name="[none:Region:nk]" pivot="key" type="nominal" />
        <column-instance column="[DriverAgeGroup]" derivation="None" name="[none:DriverAgeGroup:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehicleAgeGroup]" derivation="None" name="[none:VehicleAgeGroup:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehiclePowerGroup]" derivation="None" name="[none:VehiclePowerGroup:nk]" pivot="key" type="nominal" />
        <column-instance column="[BonusMalusGroup]" derivation="None" name="[none:BonusMalusGroup:nk]" pivot="key" type="nominal" />
      </datasource-dependencies>
      <zones>
        <zone h="100000" id="1" type="layout-basic" w="100000" x="0" y="0">
          <zone h="5000" id="2" type="title" w="100000" x="0" y="0" />
          <zone fixed-size="3000" h="3000" id="33" is-fixed="true" type="text" w="100000" x="0" y="5000">
            <formatted-text>
              <run fontcolor="#404040" fontname="Arial" fontsize="10">Compare Claim Frequency (claims per exposure year) and Average Severity (euros per claim). Circle area represents Exposure; select a driver-age mark to highlight its row in the matrix.</run>
            </formatted-text>
          </zone>
          <zone h="3500" id="40" name="Driver Age Frequency Severity" param="[federated.insurance_portfolio].[Region]" show-null-ctrls="false" type="filter" values="relevant" w="20000" x="0" y="8000" />
          <zone h="3500" id="41" name="Driver Age Frequency Severity" param="[federated.insurance_portfolio].[VehGas]" show-null-ctrls="false" type="filter" values="relevant" w="20000" x="20000" y="8000" />
          <zone h="3500" id="42" name="Driver Age Frequency Severity" param="[federated.insurance_portfolio].[DriverAgeGroup]" show-null-ctrls="false" type="filter" values="relevant" w="20000" x="40000" y="8000" />
          <zone h="3500" id="43" name="Driver Age Frequency Severity" param="[federated.insurance_portfolio].[VehicleAgeGroup]" show-null-ctrls="false" type="filter" values="relevant" w="20000" x="60000" y="8000" />
          <zone h="3500" id="44" name="Driver Age Frequency Severity" param="[federated.insurance_portfolio].[BonusMalusGroup]" show-null-ctrls="false" type="filter" values="relevant" w="20000" x="80000" y="8000" />
          <zone h="50000" id="50" name="Driver Age Frequency Severity" show-title="true" w="55000" x="0" y="12000" />
          <zone h="25000" id="51" name="Regional Claim Frequency" show-title="true" w="45000" x="55000" y="12000" />
          <zone h="25000" id="52" name="Vehicle Power Frequency" show-title="true" w="45000" x="55000" y="37000" />
          <zone h="35000" id="53" name="Driver Vehicle Frequency Matrix" show-title="true" w="100000" x="0" y="62000" />
          <zone fixed-size="3000" h="3000" id="54" is-fixed="true" type="text" w="100000" x="0" y="97000">
            <formatted-text>
              <run fontcolor="#404040" fontname="Arial" fontsize="10">Interpret segments using Claim Frequency, Average Severity, Exposure, and Claim Count together. The comparisons are descriptive, not causal.</run>
            </formatted-text>
          </zone>
        </zone>
      </zones>
    </dashboard>
    <dashboard name="Claim Cost Concentration">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#1F4E79" fontname="Arial" fontsize="16">Claim Cost Concentration</run>
          </formatted-text>
        </title>
      </layout-options>
      <size maxheight="900" maxwidth="1400" minheight="900" minwidth="1400" />
      <datasources>
        <datasource caption="Insurance Claims" name="federated.insurance_claims" />
        <datasource caption="Insurance Portfolio" name="federated.insurance_portfolio" />
      </datasources>
      <datasource-dependencies datasource="federated.insurance_claims">
        <column caption="ClaimRowID" datatype="integer" name="[ClaimRowID]" role="dimension" type="ordinal" aggregation="Sum" />
        <column caption="IDpol" datatype="string" name="[IDpol]" role="dimension" type="nominal" />
        <column caption="Claim Cost Rank" datatype="integer" name="[ClaimAmountRank]" role="dimension" type="ordinal" aggregation="Sum" />
        <column caption="Extreme Claim Flag" datatype="boolean" name="[IsExtremeClaim]" role="dimension" type="nominal" />
        <column caption="Region" datatype="string" name="[Region]" role="dimension" type="nominal" />
        <column caption="VehPower" datatype="integer" name="[VehPower]" role="dimension" type="ordinal" aggregation="Sum" />
        <column caption="VehBrand" datatype="string" name="[VehBrand]" role="dimension" type="nominal" />
        <column caption="Fuel Type" datatype="string" name="[VehGas]" role="dimension" type="nominal" />
        <column caption="Area" datatype="string" name="[Area]" role="dimension" type="nominal" />
        <column caption="Driver Age Group" datatype="string" name="[DriverAgeGroup]" role="dimension" type="nominal" />
        <column caption="Vehicle Age Group" datatype="string" name="[VehicleAgeGroup]" role="dimension" type="nominal" />
        <column caption="Vehicle Power Group" datatype="string" name="[VehiclePowerGroup]" role="dimension" type="nominal" />
        <column caption="Bonus–Malus Group" datatype="string" name="[BonusMalusGroup]" role="dimension" type="nominal" />
        <column-instance column="[ClaimRowID]" derivation="None" name="[none:ClaimRowID:ok]" pivot="key" type="ordinal" />
        <column-instance column="[IDpol]" derivation="None" name="[none:IDpol:nk]" pivot="key" type="nominal" />
        <column-instance column="[ClaimAmountRank]" derivation="None" name="[none:ClaimAmountRank:ok]" pivot="key" type="ordinal" />
        <column-instance column="[IsExtremeClaim]" derivation="None" name="[none:IsExtremeClaim:nk]" pivot="key" type="nominal" />
        <column-instance column="[Region]" derivation="None" name="[none:Region:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehPower]" derivation="None" name="[none:VehPower:ok]" pivot="key" type="ordinal" />
        <column-instance column="[VehBrand]" derivation="None" name="[none:VehBrand:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehGas]" derivation="None" name="[none:VehGas:nk]" pivot="key" type="nominal" />
        <column-instance column="[Area]" derivation="None" name="[none:Area:nk]" pivot="key" type="nominal" />
        <column-instance column="[DriverAgeGroup]" derivation="None" name="[none:DriverAgeGroup:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehicleAgeGroup]" derivation="None" name="[none:VehicleAgeGroup:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehiclePowerGroup]" derivation="None" name="[none:VehiclePowerGroup:nk]" pivot="key" type="nominal" />
        <column-instance column="[BonusMalusGroup]" derivation="None" name="[none:BonusMalusGroup:nk]" pivot="key" type="nominal" />
      </datasource-dependencies>
      <datasource-dependencies datasource="federated.insurance_portfolio">
        <column caption="IDpol" datatype="string" name="[IDpol]" role="dimension" type="nominal" />
        <column caption="VehPower" datatype="integer" name="[VehPower]" role="dimension" type="ordinal" aggregation="Sum" />
        <column caption="VehBrand" datatype="string" name="[VehBrand]" role="dimension" type="nominal" />
        <column caption="Fuel Type" datatype="string" name="[VehGas]" role="dimension" type="nominal" />
        <column caption="Area" datatype="string" name="[Area]" role="dimension" type="nominal" />
        <column caption="Region" datatype="string" name="[Region]" role="dimension" type="nominal" />
        <column caption="Driver Age Group" datatype="string" name="[DriverAgeGroup]" role="dimension" type="nominal" />
        <column caption="Vehicle Age Group" datatype="string" name="[VehicleAgeGroup]" role="dimension" type="nominal" />
        <column caption="Vehicle Power Group" datatype="string" name="[VehiclePowerGroup]" role="dimension" type="nominal" />
        <column caption="Bonus–Malus Group" datatype="string" name="[BonusMalusGroup]" role="dimension" type="nominal" />
        <column-instance column="[IDpol]" derivation="None" name="[none:IDpol:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehPower]" derivation="None" name="[none:VehPower:ok]" pivot="key" type="ordinal" />
        <column-instance column="[VehBrand]" derivation="None" name="[none:VehBrand:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehGas]" derivation="None" name="[none:VehGas:nk]" pivot="key" type="nominal" />
        <column-instance column="[Area]" derivation="None" name="[none:Area:nk]" pivot="key" type="nominal" />
        <column-instance column="[Region]" derivation="None" name="[none:Region:nk]" pivot="key" type="nominal" />
        <column-instance column="[DriverAgeGroup]" derivation="None" name="[none:DriverAgeGroup:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehicleAgeGroup]" derivation="None" name="[none:VehicleAgeGroup:nk]" pivot="key" type="nominal" />
        <column-instance column="[VehiclePowerGroup]" derivation="None" name="[none:VehiclePowerGroup:nk]" pivot="key" type="nominal" />
        <column-instance column="[BonusMalusGroup]" derivation="None" name="[none:BonusMalusGroup:nk]" pivot="key" type="nominal" />
      </datasource-dependencies>
      <zones>
        <zone h="100000" id="1" type="layout-basic" w="100000" x="0" y="0">
          <zone h="5000" id="2" type="title" w="100000" x="0" y="0" />
          <zone fixed-size="3000" h="3000" id="55" is-fixed="true" type="text" w="100000" x="0" y="5000">
            <formatted-text>
              <run fontcolor="#404040" fontname="Arial" fontsize="10">Pareto views show cumulative shares of observed claim cost. Claim amounts and Total Claim Cost are shown in euros; use the tooltips to interpret each mark. High-cost claims require review, not automatic exclusion.</run>
            </formatted-text>
          </zone>
          <zone h="56000" id="60" name="Pareto Curve" show-title="true" w="58000" x="0" y="8000" />
          <zone h="28000" id="61" name="High Cost Claims" show-title="true" w="42000" x="58000" y="8000" />
          <zone h="28000" id="62" name="High Cost Segments" show-title="true" w="42000" x="58000" y="36000" />
          <zone fixed-size="9000" h="9000" id="63" is-fixed="true" type="text" w="100000" x="0" y="64000">
            <formatted-text>
              <run fontcolor="#404040" fontname="Arial" fontsize="11">Recommendations
1. Monitor Young (18-24) for Claim Frequency and Average Severity.
2. Review Rhone-Alpes as a high-frequency, material-cost region.
3. Review high-cost claims without excluding valid observations.</run>
            </formatted-text>
          </zone>
          <zone fixed-size="3000" h="3000" id="64" is-fixed="true" type="text" w="100000" x="0" y="73000">
            <formatted-text>
              <run fontcolor="#404040" fontname="Arial" fontsize="10">Management attention: track top-1% claim-cost share, claims at or above the 99.5th percentile, and Average Severity.</run>
            </formatted-text>
          </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>
  <windows source-height="32">
    <window class="dashboard" maximized="true" name="Executive Portfolio Overview">
      <viewpoints>
        <viewpoint name="KPI Policy Count" />
        <viewpoint name="KPI Exposure" />
        <viewpoint name="KPI Claim Count" />
        <viewpoint name="KPI Claim Frequency" />
        <viewpoint name="KPI Total Claim Cost" />
        <viewpoint name="KPI Average Severity" />
        <viewpoint name="Regional Claim Frequency" />
        <viewpoint name="Regional Claim Cost" />
      </viewpoints>
      <active id="-1" />
    </window>
    <window class="dashboard" maximized="true" name="Claims &amp; Risk Segments">
      <viewpoints>
        <viewpoint name="Driver Age Frequency Severity" />
        <viewpoint name="Regional Claim Frequency" />
        <viewpoint name="Vehicle Power Frequency" />
        <viewpoint name="Driver Vehicle Frequency Matrix" />
      </viewpoints>
      <active id="-1" />
    </window>
    <window class="dashboard" maximized="true" name="Claim Cost Concentration">
      <viewpoints>
        <viewpoint name="Pareto Curve" />
        <viewpoint name="High Cost Claims" />
        <viewpoint name="High Cost Segments" />
      </viewpoints>
      <active id="-1" />
    </window>
  </windows>
</workbook>