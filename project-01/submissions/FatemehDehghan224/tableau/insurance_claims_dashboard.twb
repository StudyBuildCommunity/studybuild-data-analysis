  <actions>
    <action caption="Filter overview by selected region" name="[Action_Filter_Selected_Region]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="Executive Portfolio Overview" type="sheet" worksheet="Regional Claim Frequency" />
      <command command="tsc:tsl-filter">
        <param name="exclude" value="Regional Claim Frequency" />
        <param name="special-fields" value="all" />
        <param name="target" value="Executive Portfolio Overview" />
      </command>
    </action>
    <action caption="Highlight selected driver age group in matrix" name="[Action_Highlight_Driver_Age]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="Claims &amp; Risk Segments" type="sheet" worksheet="Driver Age Frequency Severity" />
      <command command="tsc:brush">
        <param name="exclude" value="Driver Age Frequency Severity" />
        <param name="field-captions" value="Driver Age Group" />
        <param name="target" value="Claims &amp; Risk Segments" />
      </command>
    </action>
  </actions>
