      <column caption="IDpol" datatype="string" name="[IDpol]" role="dimension" type="nominal" />
      <column caption="Exposure" datatype="real" name="[Exposure]" role="measure" type="quantitative" aggregation="Sum" default-format="n#,##0.0" />
      <column caption="Claim Count" datatype="integer" name="[ClaimNb]" role="measure" type="quantitative" aggregation="Sum" default-format="n#,##0" />
      <column caption="VehPower" datatype="integer" name="[VehPower]" role="dimension" type="ordinal" aggregation="Sum" />
      <column caption="VehAge" datatype="integer" name="[VehAge]" role="measure" type="quantitative" aggregation="Sum" default-format="n#,##0" />
      <column caption="DrivAge" datatype="integer" name="[DrivAge]" role="measure" type="quantitative" aggregation="Sum" default-format="n#,##0" />
      <column caption="BonusMalus" datatype="integer" name="[BonusMalus]" role="measure" type="quantitative" aggregation="Sum" default-format="n#,##0" />
      <column caption="VehBrand" datatype="string" name="[VehBrand]" role="dimension" type="nominal" />
      <column caption="Fuel Type" datatype="string" name="[VehGas]" role="dimension" type="nominal" />
      <column caption="Area" datatype="string" name="[Area]" role="dimension" type="nominal" />
      <column caption="Density" datatype="integer" name="[Density]" role="measure" type="quantitative" aggregation="Sum" default-format="n#,##0" />
      <column caption="Region" datatype="string" name="[Region]" role="dimension" type="nominal" />
      <column caption="Total Claim Cost" datatype="real" name="[TotalClaimAmount]" role="measure" type="quantitative" aggregation="Sum" default-format="c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)" />
      <column caption="SeverityClaimCount" datatype="integer" name="[SeverityClaimCount]" role="measure" type="quantitative" aggregation="Sum" default-format="n#,##0" />
      <column caption="Average Claim Amount" datatype="real" name="[AverageClaimAmount]" role="measure" type="quantitative" aggregation="Sum" default-format="c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)" />
      <column caption="Maximum Claim Amount" datatype="real" name="[MaxClaimAmount]" role="measure" type="quantitative" aggregation="Sum" default-format="c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)" />
      <column caption="Driver Age Group" datatype="string" name="[DriverAgeGroup]" role="dimension" type="nominal" />
      <column caption="Vehicle Age Group" datatype="string" name="[VehicleAgeGroup]" role="dimension" type="nominal" />
      <column caption="Vehicle Power Group" datatype="string" name="[VehiclePowerGroup]" role="dimension" type="nominal" />
      <column caption="Bonus–Malus Group" datatype="string" name="[BonusMalusGroup]" role="dimension" type="nominal" />
      <column caption="Policy Count" datatype="integer" default-format="n#,##0" name="[Policy Count]" role="measure" type="quantitative">
        <calculation class="tableau" formula="1" />
      </column>
      <column caption="Claim Frequency" datatype="real" default-format="n0.0000" name="[Claim Frequency]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([ClaimNb]) / SUM([Exposure])" />
      </column>
      <column caption="Average Severity" datatype="real" default-format="c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)" name="[Average Severity]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF SUM([SeverityClaimCount]) = 0 THEN NULL ELSE SUM([TotalClaimAmount]) / SUM([SeverityClaimCount]) END" />
      </column>
    </datasource>
