      </zone>
      <zone h="200" id="8" is-spatial-root="true" r="1200" x="800" y="700" w="400">
        <filter column="[policy_level].[DensityGroup]" datasources="[policy_level].[DensityGroup]" />
      </zone>
      <dashboard-actions>
        <dashboard-action class="filter" name="Region Filter">
          <source-sheets>Regional_Frequency_Bar, Regional_CostPerExposure_Bar, Highlight_Table</source-sheets>
          <target-sheets>KPI_Cards, Highlight_Table</target-sheets>
        </dashboard-action>
      </dashboard-actions>
    </dashboard>
    <dashboard name="Page 2 - Claims &amp; Risk Segments">
      <size maxheight="900" maxwidth="1200" minheight="900" minwidth="1200" />
      <zone h="50" id="1" is-spatial-root="true" r="1200" x="0" y="0" w="1200">
