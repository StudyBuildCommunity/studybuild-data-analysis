  <dashboards>
    <dashboard name="Page 1 - Executive Portfolio Overview">
      <size maxheight="900" maxwidth="1200" minheight="900" minwidth="1200" />
      <zone h="50" id="1" is-spatial-root="true" r="1200" x="0" y="0" w="1200">
        <text val="INSURANCE CLAIMS &amp; PORTFOLIO RISK DASHBOARD  --  French Motor Third-Party Liability (freMTPL2)" />
      </zone>
      <zone h="100" id="2" is-spatial-root="true" r="1200" x="0" y="50" w="1200">
